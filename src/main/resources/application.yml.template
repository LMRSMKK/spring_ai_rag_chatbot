# 使用说明：复制此文件为 application.yml，并填入真实值
server:
  port: 8080

spring:
  application:
    name: spring-ai-language

  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/lmretext?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=true&serverTimezone=Asia/Shanghai
    username: root
    password: ${DB_PASSWORD}       # ← 填入 MySQL 密码

  data:
    redis:
      host: localhost
      port: 6379
      password: ${REDIS_PASSWORD}  # ← Redis 密码（无则留空）

  servlet:
    multipart:
      max-file-size: 50MB
      max-request-size: 50MB

  ai:
    ollama:
      base-url: http://localhost:11434
      chat:
        model: qwen2.5:3b-instruct
        options:
          temperature: 0.7
          num_ctx: 4096
      embedding:
        model: all-minilm:22m

    deepseek:
      chat:
        api-key: ${DEEPSEEK_API_KEY}   # ← 填入 DeepSeek API Key
        model: deepseek-chat
        enable-thinking: false
    agnes:
      chat:
        api-key: ${AGNES_API_KEY}      # ← 填入 Agnes API Key
        base-url: https://apihub.agnes-ai.com
        model: agnes-2.5-flash

    vectorstore:
      chroma:
        client:
          base-url: http://localhost:8000
        collection-name: rag_kb_collection
        initialize-schema: true
    chat:
      memory:
        repository:
          jdbc:
            initialize-schema: never

logging:
  level:
    org.springframework.ai.chat.client.advisor: DEBUG
    org.mybatis: DEBUG
    org.springframework.ai.ollama: TRACE
    com.example.spring_ai_language: DEBUG

mybatis-plus:
  mapper-locations: classpath:mapper/*.xml
  type-aliases-package: com.example.spring_ai_language.entity
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl

app:
  rag:
    chunk-size: 500
    chunk-overlap: 50
    high-confidence-threshold: 0.75
    med-confidence-threshold: 0.4
    min-top-k: 5
    top-k: 5
    rerank-top-k: 10
  sensitive-words:
    enable: true
    words: "敏感词1,敏感词2"

management:
  endpoints:
    web:
      exposure:
        include: health,info
  endpoint:
    health:
      show-details: always
      show-components: always
